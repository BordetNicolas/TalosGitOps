# Secrets / local environment (old single-cluster location — kept for safety)
.env
*.env.local

# Per-cluster secrets and generated artifacts
clusters/*/cluster.env
clusters/*/kubeconfig
clusters/*/talosconfig
clusters/*/talsecret.yaml
clusters/*/clusterconfig/
clusters/*/.secrets-rendered/
clusters/*/gitops/**/secret-*.yaml
clusters/*/gitops/doppler/doppler-service-token-secret.yaml

# OpenTofu / Terraform local artifacts (state lives in MinIO)
tofu/.terraform/
tofu/.terraform.lock.hcl
tofu/*.tfstate
tofu/*.tfstate.backup
tofu/crash.log
tofu/crash.*.log
tofu/terraform.tfvars
tofu/.cache/
*.tfplan

# Talos generated artifacts (per-run, cluster-specific)
kubeconfig
talosconfig
clusterconfig/
talos/talconfig.yaml
talos/talsecret.yaml
talos/.talhelper-cache/
talos/patches/*.generated.yaml

# Talos ISO artifacts (cached locally if generated outside of Proxmox)
*.iso

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp
*~
clusters/talos-02/terraform.tfvars
