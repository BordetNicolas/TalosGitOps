# ---------------------------------------------------------------------------
# Per-cluster environment — copy to clusters/<name>/cluster.env and fill in.
# The Makefile sources this file and exports every variable to OpenTofu and
# the helper scripts.  Never commit the filled-in file (gitignored by default).
# ---------------------------------------------------------------------------

# ---------- Ingress (PLATFORM_ENV + domaine) ---------------------------------
# Hostnames : argocd-<PLATFORM_ENV>.<domaine>, longhorn-<PLATFORM_ENV>.<domaine>, etc.
# Si PLATFORM_ENV est prd ou prod : argocd.<domaine>, longhorn.<domaine> (sans suffixe).
PLATFORM_ENV=dev
CLOUDFLARE_DOMAIN=example.com

# ---------- Proxmox --------------------------------------------------------
PROXMOX_VE_ENDPOINT=https://pve1.lan:8006
PROXMOX_VE_API_TOKEN=user@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_VE_INSECURE=true

# ---------- MinIO (shared across clusters) ---------------------------------
AWS_ACCESS_KEY_ID=xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
MINIO_ENDPOINT=https://minio.lan:9000
MINIO_INSECURE=false
MINIO_REGION=us-east-1
MINIO_STATE_BUCKET=talos-tfstate
MINIO_KUBECONFIG_BUCKET=kubeconfigs
# MINIO_STATE_KEY and MINIO_KUBECONFIG_KEY are auto-derived from CLUSTER
# (e.g. talos-01/terraform.tfstate and talos-01/kubeconfig).
# Uncomment to override:
# MINIO_STATE_KEY=talos-01/terraform.tfstate
# MINIO_KUBECONFIG_KEY=talos-01/kubeconfig

# ---------- ArgoCD / GitOps ------------------------------------------------
ARGOCD_GIT_REPO=https://github.com/me/talos.git
ARGOCD_GIT_REVISION=main
# Repo applications métier (pont workloads-root → clusters/<CLUSTER>/apps/)
APPS_GIT_REPO=https://github.com/me/homelab-apps.git
APPS_GIT_REVISION=main
ARGOCD_CHART_VERSION=8.3.0
# Surcharges optionnelles (sinon calculées par make gitops-render depuis PLATFORM_ENV) :
# ARGOCD_INGRESS_HOST=argocd-dev.example.com
# LONGHORN_INGRESS_HOST=longhorn-dev.example.com
# GRAFANA_INGRESS_HOST=grafana-dev.example.com

# ---------- Cilium ---------------------------------------------------------
CILIUM_CHART_VERSION=1.16.4

# ---------- MetalLB --------------------------------------------------------
METALLB_POOL_RANGE=192.168.1.60-192.168.1.79

# ---------- cert-manager (non-secret; email in ClusterIssuer) --------------
ACME_EMAIL=admin@example.com

# ---------- Doppler (Free plan: service token) -----------------------------
# App secrets (CLOUDFLARE_API_TOKEN, UNIFI_*, GRAFANA_ADMIN_USER, GRAFANA_ADMIN_PASSWORD, …) live in Doppler project/config.
# Create one Service Token in Doppler UI with read access to that config.
DOPPLER_SERVICE_TOKEN=dp.st.xxxx
DOPPLER_PROJECT=homelab
DOPPLER_CONFIG=prd

# ---------- External-DNS ---------------------------------------------------
CLOUDFLARE_DOMAIN=example.com
UNIFI_DOMAIN=home.example.com
# URL complète du contrôleur UniFi (obligatoire si external-dns-unifi est actif).
UNIFI_HOST=https://192.168.1.1
UNIFI_SKIP_TLS_VERIFY=true

# ---------- Talos CLI override (optional) ----------------------------------
# TALOS_FETCH_NODES=192.168.14.30
# TALOS_FETCH_ENDPOINTS=192.168.14.30
