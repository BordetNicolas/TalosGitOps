# ---------------------------------------------------------------------------
# Talos cluster / Proxmox automation environment
#
# Copy this file to `.env` and fill in the values. The Makefile loads `.env`
# automatically and exports every variable below to OpenTofu and the helper
# scripts.
# ---------------------------------------------------------------------------

# ---------- Proxmox -------------------------------------------------------- 
# Endpoint of the Proxmox VE API and the API token used to authenticate.
# The bpg/proxmox provider expects PROXMOX_VE_* environment variables.
PROXMOX_VE_ENDPOINT=https://pve1.lan:8006
PROXMOX_VE_API_TOKEN=user@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_VE_INSECURE=true

# ---------- MinIO (state backend + kubeconfig publication) ---------------- 
# Standard AWS env vars are reused by both the S3 backend and the AWS provider.
AWS_ACCESS_KEY_ID=xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# MinIO endpoint and bucket layout
MINIO_ENDPOINT=https://minio.lan:9000
MINIO_REGION=us-east-1
MINIO_STATE_BUCKET=talos-tfstate
MINIO_STATE_KEY=talos-pve1/terraform.tfstate
MINIO_KUBECONFIG_BUCKET=kubeconfigs
MINIO_KUBECONFIG_KEY=talos-pve1/kubeconfig

# ---------- ArgoCD / GitOps ----------------------------------------------- 
# Repository and path that ArgoCD will sync as the App-of-Apps source of truth.
# By default this points to the same repository, sub-folder `gitops/`.
ARGOCD_GIT_REPO=https://github.com/me/talos.git
ARGOCD_GIT_REVISION=main
ARGOCD_GIT_PATH=gitops
ARGOCD_INGRESS_HOST=argocd.lan
ARGOCD_CHART_VERSION=7.7.7

# ---------- Cilium bootstrap ---------------------------------------------- 
CILIUM_CHART_VERSION=1.16.4
