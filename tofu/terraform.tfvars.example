proxmox = {
  endpoint   = "https://pve1.lan:8006"
  api_token  = "user@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  insecure   = true
  node       = "pve1"
  iso_store  = "local"
  disk_store = "local-lvm"
  bridge     = "vmbr0"
  # vlan_tag = 14 # optionnel : tag 802.1Q sur la vNIC (bridge vlan-aware sur l’hôte)
}

cluster = {
  name = "talos"
  # Optionnel : forcer l’hôte API (DNS / IP). Sinon = IP DHCP du 1er control plane (output kubernetes_api_host).
  # kubernetes_api_host = "api.moncluster.lan"
  talos_version      = "v1.13.2"
  kubernetes_version = "1.36.1"
  # Disque OS Talos (scsi0 sur les VMs de ce dépôt → en général /dev/sda)
  # install_disk = "/dev/vda"
}

control_plane = {
  count     = 3
  cores     = 2
  memory_mb = 4096
  disk_gb   = 50
}

worker = {
  count     = 3
  cores     = 4
  memory_mb = 8192
  disk_gb   = 50
  longhorn_disks = [
    { size_gb = 100, ssd = true },
  ]
}

minio = {
  endpoint          = "https://minio.lan:9000"
  state_bucket      = "talos-tfstate"
  kubeconfig_bucket = "kubeconfigs"
}
# Note: state/kubeconfig keys are auto-derived from cluster.name (e.g. talos-01/terraform.tfstate).
