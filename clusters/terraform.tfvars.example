proxmox = {
  endpoint   = "https://pve1.lan:8006"
  api_token  = "user@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  insecure   = true
  node       = "pve1"
  iso_store  = "local"
  disk_store = "local-lvm"
  bridge     = "vmbr0"
  # vlan_tag = 14  # optional: 802.1Q VLAN tag on the vNIC (bridge must be vlan-aware)
}

cluster = {
  # Must match the clusters/<name> directory (make CLUSTER=<name>).
  name = "talos-01"
  # Optional: force the API host (DNS name or static IP).
  # If unset, the first control-plane's DHCP IP (via Proxmox guest agent) is used.
  # kubernetes_api_host = "api.talos-01.lan"
  talos_version      = "v1.13.2"
  kubernetes_version = "1.36.1"
  # install_disk = "/dev/vda"  # default: /dev/sda (virtio-scsi, scsi0)
}

control_plane = {
  count     = 3
  cores     = 2
  memory_mb = 4096
  disk_gb   = 50
}

worker = {
  count     = 3
  cores     = 4
  memory_mb = 8192
  disk_gb   = 50
  longhorn_disks = [
    { size_gb = 100, ssd = true },
  ]
}

minio = {
  endpoint          = "https://minio.lan:9000"
  state_bucket      = "talos-tfstate"
  kubeconfig_bucket = "kubeconfigs"
}
